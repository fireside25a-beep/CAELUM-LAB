; CAELUM exact-arithmetic obligation: matrix_span
(set-option :timeout 30000)
(set-logic QF_NIA)
(declare-const rows Int)
(declare-const cols Int)
(declare-const stride Int)
(declare-const limit Int)
(declare-const i Int)
(declare-const j Int)
(assert (> rows 0))
(assert (> cols 0))
(assert (>= stride cols))
(assert (>= limit cols))
(assert (<= (+ (* (- rows 1) stride) cols) limit))
(assert (<= 0 i))
(assert (< i rows))
(assert (<= 0 j))
(assert (< j cols))
(assert (or (< (+ (* i stride) j) 0) (>= (+ (* i stride) j) limit)))
(check-sat)
