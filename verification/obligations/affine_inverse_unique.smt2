; CAELUM exact-arithmetic obligation: affine_inverse_unique
(set-option :timeout 30000)
(set-logic QF_NRA)
(declare-const x Real)
(declare-const z Real)
(declare-const w Real)
(declare-const h Real)
(declare-const a Real)
(declare-const b Real)
(assert (not (= (- 1 (/ (* h a) 2)) 0)))
(assert (not (= (+ 1 (/ (* h a) 2)) 0)))
(assert (= (- z x) (* h (+ (* a (/ (+ x z) 2)) b))))
(assert (= (- w z) (* (- h) (+ (* a (/ (+ z w) 2)) b))))
(assert (not (= w x)))
(check-sat)
