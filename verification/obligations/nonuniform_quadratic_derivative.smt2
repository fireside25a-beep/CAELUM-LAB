; CAELUM exact-arithmetic obligation: nonuniform_quadratic_derivative
(set-option :timeout 30000)
(set-logic QF_NRA)
(declare-const a Real)
(declare-const b Real)
(declare-const c Real)
(declare-const t Real)
(declare-const h1 Real)
(declare-const h2 Real)
(declare-const d1 Real)
(declare-const d2 Real)
(declare-const d Real)
(assert (> h1 0))
(assert (> h2 0))
(assert (= (* h1 d1) (- (+ (* a t t) (* b t) c) (+ (* a (- t h1) (- t h1)) (* b (- t h1)) c))))
(assert (= (* h2 d2) (- (+ (* a (+ t h2) (+ t h2)) (* b (+ t h2)) c) (+ (* a t t) (* b t) c))))
(assert (= (* (+ h1 h2) d) (+ (* h2 d1) (* h1 d2))))
(assert (not (= d (+ (* 2 a t) b))))
(check-sat)
